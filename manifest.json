{
  "manifest_version": 3,
  "name": "URLオートフィル",
  "version": "0.1.0",
  "description": "ページのURLごとにフォーム入力内容を自動保存し、次回アクセス時に自動で再入力します。",
  "permissions": ["storage", "activeTab", "tabs"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "URLオートフィル"
  }
}
